# =============================================================================
# PumpingCLI — configurazione voce
# Copia questo file in .env (escluso da git) e inserisci la tua API key:
#   cp .env.example .env
# Le opzioni da riga di comando (--engine, --voice, --style) hanno la
# precedenza sui valori di questo file.
# =============================================================================


# --- Motore voce -------------------------------------------------------------
# gemini : Gemini TTS, API ufficiale Google (consigliato)
# edge   : voci neurali Microsoft Edge, servizio non ufficiale
# macos  : sintesi locale con il comando say
# Se la riga manca, il default è edge.
TTS_ENGINE=gemini
# TTS_ENGINE=edge
# TTS_ENGINE=macos


# --- Gemini TTS --------------------------------------------------------------
# API key gratuita da https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Voce: un alias preimpostato oppure un ID del catalogo
# (elenco completo: GET https://generativelanguage.googleapis.com/v1beta/voices)
# (i commenti vanno su righe a parte: dopo il valore non sono supportati)
#   chiara = it-it-csagent-1, 36 anni, nitida e decisa (default)
#   sofia  = it-it-tutor-7, 25 anni, sicura e chiara
#   laura  = Laomedeia, energica, tono alto
GEMINI_VOICE=chiara
# GEMINI_VOICE=sofia
# GEMINI_VOICE=laura
# Esempio di ID del catalogo usato direttamente:
# GEMINI_VOICE=it-it-training-5

# Stile di lettura. Cambiarlo rigenera le frasi alla prima esecuzione.
# Se la riga manca, si usa il primo stile qui sotto; con il valore vuoto
# Gemini legge senza indicazioni di stile.
# GEMINI_STYLE=personal trainer italiano, energico e motivante, ritmo deciso
# GEMINI_STYLE=calmo e rilassato, ritmo lento, adatto al defaticamento
# GEMINI_STYLE=


# --- Edge TTS ----------------------------------------------------------------
# Voce usata con TTS_ENGINE=edge, e come riserva quando Gemini non risponde.
# Se la riga manca, il default è elsa.
# EDGE_VOICE=elsa
# EDGE_VOICE=isabella
# EDGE_VOICE=diego
# EDGE_VOICE=giuseppe


# --- macOS say ---------------------------------------------------------------
# Con TTS_ENGINE=macos la voce si sceglie solo con --voice (es. --voice Alice);
# senza --voice, say usa la voce di sistema.
